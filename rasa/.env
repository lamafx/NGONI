# Rasa core settings
RASA_MODEL_SERVER=http://127.0.0.1:5005
RASA_ENABLE_API=true

# Tracker store persistant (voir endpoints.yml) -- sans ca, Rasa retombe sur
# l'InMemoryTrackerStore par defaut : tout l'historique de conversation est
# perdu a chaque redemarrage du conteneur. Meme instance Postgres que
# FastAPI (host.docker.internal car ce conteneur tourne dans Docker, la base
# elle tourne nativement sur l'hote).
TRACKER_DB_HOST=host.docker.internal
TRACKER_DB_PORT=5432
TRACKER_DB_USER=chatbot_user
TRACKER_DB_PASSWORD=L@djilama123
TRACKER_DB_NAME=chatbotdb
