SUPPORT_CONTACT_PHONE=+225 00 00 00 00
WITHDRAW_SERVICE_URL=http://host.docker.internal:8000/conversations/withdraw

# Reponse de repli generee par Qwen avec le fil de la conversation (rasa/actions/common.py,
# generate_redirect_reply). DESACTIVE par defaut : ~30s de plus sans GPU. true pour l activer.
LLM_REPLY_ENABLED=false
LLM_REPLY_MODEL=qwen3:1.7b
LLM_REPLY_TIMEOUT=20
OLLAMA_CHAT_URL=http://host.docker.internal:11434/api/chat
# Memoire entre conversations (GET /conversations/memory) -- deduite de FAQ_SERVICE_URL si absente.
# MEMORY_SERVICE_URL=http://host.docker.internal:8000/conversations/memory
