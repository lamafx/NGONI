# Rasa core settings
RASA_MODEL_SERVER=http://127.0.0.1:5005
RASA_ENABLE_API=true

# Tracker store persistant (voir endpoints.yml et docs) -- sans ca, tout
# l'historique de conversation est perdu a chaque redemarrage du conteneur.
TRACKER_DB_HOST=host.docker.internal
TRACKER_DB_PORT=5432
TRACKER_DB_USER=chatbot_user
TRACKER_DB_PASSWORD=changeme
TRACKER_DB_NAME=chatbotdb

# Memoire de conversation dans le classifieur NLU (rasa/components/qwen_intent_classifier.py) :
# derniers echanges + etat de la tache envoyes par le frontend (metadata.dialogue_context).
# DESACTIVE par defaut : sans GPU, +20s par message et moins juste (voir docs/20). true pour essayer.
NLU_CONTEXT_ENABLED=false
NLU_CONTEXT_MAX_TURNS=4
