DATABASE_URL=postgresql+psycopg://chatbot_user:changeme@127.0.0.1:5432/chatbotdb
RASA_PARSE_URL=http://127.0.0.1:5005/model/parse
RASA_WEBHOOK_URL=http://127.0.0.1:5005/webhooks/rest/webhook
WALLET_SERVICE_INTERNAL_SECRET=changeme
USER_SERVICE_INTERNAL_SECRET=changeme
# Frequence (secondes) de rafraichissement du Capability Registry du
# Diagnostic Engine -- 300 par defaut en production (voir registry.py).
# Descendre a 30 en developpement local pour voir un changement de manifeste
# plus vite.
REGISTRY_POLL_INTERVAL_SECONDS=300
# Secret partage protegeant les futures routes admin (Depends(require_admin_auth),
# voir app/shared/admin_auth.py) -- header X-Internal-Secret attendu, meme
# convention que ngoni-core-service. Aucune route n'existe encore a ce jour ;
# laisser vide/absent est sans consequence tant qu'aucune route admin n'a ete
# ajoutee (avertissement au demarrage dans ce cas, voir main.py::startup).
# Definir une vraie valeur avant d'ecrire la premiere route admin.
ADMIN_INTERNAL_SECRET=
