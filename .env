# Configuration de la pile Docker (docker-compose.yml) -- voir README.md.
# Copier ce fichier en .env et remplir les valeurs. Le .env n'est jamais commite.

# --- PostgreSQL --------------------------------------------------------------
# Mot de passe du superutilisateur `postgres` du conteneur.
POSTGRES_PASSWORD=5dc9685433179e700fe60641
# Compte utilise par FastAPI, les services et Rasa. Lettres et chiffres
# uniquement : le mot de passe est insere tel quel dans l'URL de connexion.
APP_DB_USER=chatbot_user
APP_DB_PASSWORD=c7a3e1172737f514c4c6e976
APP_DB_NAME=chatbotdb
# Port cote hote (5432 est souvent deja pris par un PostgreSQL Windows).
POSTGRES_HOST_PORT=5433

# --- Secrets internes --------------------------------------------------------
# Routes d'administration (en-tete X-Internal-Secret). L'interface web le
# recoit au build : apres un changement, reconstruire -> docker compose up -d --build frontend
ADMIN_INTERNAL_SECRET=dev-admin-secret-change-me
# Secret partage entre FastAPI et les services wallet / user.
SERVICES_INTERNAL_SECRET=test-secret

# --- Comportement ------------------------------------------------------------
# Rafraichissement du catalogue de diagnostic (s).
REGISTRY_POLL_INTERVAL_SECONDS=300
# Memoire de conversation dans le classifieur LLM (lent sans GPU).
NLU_CONTEXT_ENABLED=false
NLU_CONTEXT_MAX_TURNS=4
# Reponse de repli generee par le LLM (~30 s de plus sans GPU).
LLM_REPLY_ENABLED=false
SUPPORT_CONTACT_EMAIL=support@ngoni.com
SUPPORT_CONTACT_PHONE=+225 00 00 00 00

# --- pgAdmin (optionnel : docker compose --profile outils up -d pgadmin) -----
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
