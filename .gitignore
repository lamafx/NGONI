# Config machine-locale (Rasa/Keras, generee automatiquement, pas du projet)
rasa/.config/
rasa/.keras/

# Frontend : versionne (son propre frontend/.gitignore exclut node_modules,
# dist et .vite).

# Corbeille locale (plusieurs centaines de Mo, jamais versionnee)
trash/

# Artefacts de developpement / experimentation (non necessaires en prod)
scratchpad/
rasa/results/
rasa/experiment/

# Export de la base (donnees reelles : conversations, KYC) -- jamais commite.
docker/postgres/*.dump
